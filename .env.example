# Empty template only. Copy to a local .env; never commit a completed file.
# coatlearn.models.presets read only their required key at run time, after data
# validation. Default: .env in the Python process's working directory; no parent
# search or interpolation. Existing process environment values win, even if empty.
# A loaded key is kept in os.environ; switching env_file does not replace it.
# dpsk41f (main or annotation):
DEEPSEEK_API_KEY=
# jev (annotation only); also used by explicitly configured Jev judge/dedup:
TYPESAFE_API_KEY=

# Optional legacy/advanced ModelConfig variables; only when api_key_env names them.
# Explicit ModelConfig does not load dotenv automatically. If needed, call:
# from dotenv import load_dotenv
# load_dotenv(".env", override=False, interpolate=False)
COAT_MAIN_API_KEY=
COAT_ANNOTATION_API_KEY=
